# Copy to .env (never commit .env). Flutter needs --dart-define at run time.
# Use scripts/run-dev.ps1 to load .env automatically.

SUPABASE_URL=https://qmivgvctmxvpnbouqslj.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key

# E2E script (scripts/test-web-tools-e2e.ps1) — dedicated test account, not production users
TEST_USER_EMAIL=your_test_user@example.com
TEST_USER_PASSWORD=your_test_password

GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# --- Cloudflare Pages (Settings -> Environment variables) ---
# SUPABASE_URL, SUPABASE_ANON_KEY, GOOGLE_WEB_CLIENT_ID (single-line values, no line breaks)
# Build command: bash scripts/cloudflare-build.sh
# Output directory: build/web

# Cursor MCP / Supabase CLI only — Personal Access Token from Account -> Tokens
# https://supabase.com/dashboard/account/tokens
# NOT the project Secret key from Project Settings -> API (never put that here).
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token

# Edge Function secrets — set in Supabase Dashboard -> Edge Functions -> Secrets only
# FCM_SERVICE_ACCOUNT_JSON — paste full Firebase Admin SDK JSON (NOT google-services.json)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Default path for scripts/setup-fcm-push.ps1 (optional local reference only; never commit the file)
# FCM_ADMINSDK_JSON_PATH=C:\path\to\firebase-adminsdk.json

# Optional: copy OPENAI_API_KEY here temporarily to run tools/test-openai-vision.ps1 locally (never commit)
