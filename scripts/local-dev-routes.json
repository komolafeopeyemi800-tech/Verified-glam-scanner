{
  "_comment": "Local dev reference only — NOT deployed. local-web-server.mjs implements /app/* inline. Wrangler uses wrangler.toml not_found_handling.",
  "cleanUrls": false,
  "redirects": [
    { "source": "/marketing/about.html", "destination": "/about", "type": 301 },
    { "source": "/marketing/privacy.html", "destination": "/privacy", "type": 301 },
    { "source": "/marketing/terms.html", "destination": "/terms", "type": 301 },
    { "source": "/marketing/index.html", "destination": "/", "type": 301 },
    { "source": "/marketing/", "destination": "/", "type": 301 },
    { "source": "/marketing", "destination": "/", "type": 301 }
